NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
STORE_NAME=Spices of Yash
CURRENCY=INR
# Optional: set after deploying behind HTTPS
COOKIE_SECURE=false

# UPI merchant VPA, e.g. yourname@bank. Keep payment status pending until verified.
UPI_ID=

# Razorpay payment gateway (use Test Mode keys first; never expose the secret in frontend code)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional for a future verified webhook endpoint
RAZORPAY_WEBHOOK_SECRET=

# ---- Storefront contact & settings (v3) — leave blank to hide ----
# Public site address used for SEO tags, sitemap and structured data
SITE_URL=https://spices-of-yash-store.onrender.com
# Free delivery threshold in rupees
FREE_DELIVERY_MIN=799
# WhatsApp number with country code, digits only, e.g. 919876543210 (shows the floating chat button)
WHATSAPP_NUMBER=
CONTACT_EMAIL=
CONTACT_PHONE=
STORE_ADDRESS=
# 14-digit FSSAI licence number (shown in footer)
FSSAI_NUMBER=
INSTAGRAM_URL=
FACEBOOK_URL=
YOUTUBE_URL=

# ---- v3.1 ----
# Postgres connection string (Neon / Render / Supabase). Leave blank to use the local SQLite file in data/.
DATABASE_URL=
# Flat delivery charge (₹) for orders below FREE_DELIVERY_MIN. Set 0 for always-free delivery.
DELIVERY_FEE=49
# New-order alerts on Telegram — see README "Order alerts"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Creates the first admin automatically on an empty database (e.g. a fresh Postgres). Remove after first login.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
