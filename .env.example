NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
STORE_NAME=Spices of Yash
CURRENCY=INR
# Optional: set after deploying behind HTTPS
COOKIE_SECURE=false

# UPI merchant VPA, e.g. yourname@bank. Keep payment status pending until verified.
UPI_ID=

# Razorpay payment gateway (use Test Mode keys first; never expose the secret in frontend code)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional for a future verified webhook endpoint
RAZORPAY_WEBHOOK_SECRET=
